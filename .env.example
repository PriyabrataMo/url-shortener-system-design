# Copy this file to .env for local development.
# Never commit .env or a real tunnel token.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-a-token-from-cloudflare
SHORT_URL_BASE=http://localhost:8000/r
NEXT_PUBLIC_API_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Used only by the public k6 profile. Replace with your public API hostname.
PUBLIC_API_URL=https://api.example.com
